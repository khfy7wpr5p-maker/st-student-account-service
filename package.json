{
  "name": "st-student-account-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/*.test.js tests/contract/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:contract": "node --test tests/contract/*.test.js",
    "test:emulator": "firebase emulators:exec --project demo-st-student-account --only auth,firestore,database \"node --test tests/emulator/*.test.js\"",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js"
  },
  "engines": {"node": ">=24.0.0 <25"},
  "dependencies": {"express": "4.21.2","firebase-admin": "14.4.0"},
  "devDependencies": {"@firebase/rules-unit-testing": "5.0.2","firebase": "12.19.0","firebase-tools": "15.32.0"}
}
